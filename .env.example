# Puerto del servidor (Render lo define solo en producción).
PORT=4000
# Orígenes permitidos por CORS, separados por comas. Ejemplo: https://tu-frontend.vercel.app,http://localhost:5173
CORS_ORIGINS=
# Cuenta de servicio de Firebase (la misma de backend-api). En local: ruta al archivo JSON. En Render: el JSON completo.
FIREBASE_SERVICE_ACCOUNT=
